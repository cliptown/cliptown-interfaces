{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cliptown/cliptown-interfaces/raw/main/embedding-contract/embedding-record.schema.json",
  "title": "ClipTown stored embedding v2",
  "description": "Portable 4,100-slot embedding contract for encrypted clipboard history and privacy-safe semantic discovery. Trailing zeros preserve smaller provider outputs without claiming that padding adds information.",
  "$ref": "StoredEmbedding.json",
  "$defs": {
    "EmbeddingProvider": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "EmbeddingProvider.json",
      "type": "string",
      "enum": [
        "openai",
        "google",
        "voyage",
        "qwen",
        "nvidia",
        "baai",
        "custom"
      ]
    },
    "GenerationProvider": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "GenerationProvider.json",
      "type": "string",
      "enum": [
        "openai",
        "anthropic",
        "google",
        "qwen",
        "nvidia",
        "baai",
        "custom"
      ]
    },
    "EmbeddingPurpose": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "EmbeddingPurpose.json",
      "type": "string",
      "enum": [
        "clip_search",
        "clip_deduplication",
        "discovery"
      ]
    },
    "EmbeddingNormalization": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "EmbeddingNormalization.json",
      "type": "string",
      "enum": [
        "provider",
        "l2",
        "none"
      ]
    },
    "EmbeddingMetadata": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "EmbeddingMetadata.json",
      "type": "object",
      "properties": {},
      "unevaluatedProperties": {},
      "description": "Arbitrary metadata is intentionally open while the containing record is closed."
    },
    "EmbeddingInput": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "EmbeddingInput.json",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "embeddingProvider",
        "model",
        "values"
      ],
      "properties": {
        "embeddingProvider": {
          "$ref": "EmbeddingProvider.json"
        },
        "generationProvider": {
          "anyOf": [
            { "$ref": "GenerationProvider.json" },
            { "type": "null" }
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "StoredEmbedding": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "StoredEmbedding.json",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "entityKind",
        "entityId",
        "purpose",
        "embeddingProvider",
        "model",
        "originalDimensions",
        "embeddingSpace",
        "storageDimensions",
        "values",
        "normalization",
        "contentHash"
      ],
      "properties": {
        "tenantId": {
          "type": "string",
          "format": "uuid"
        },
        "entityKind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "entityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "purpose": {
          "$ref": "EmbeddingPurpose.json"
        },
        "embeddingProvider": {
          "$ref": "EmbeddingProvider.json"
        },
        "generationProvider": {
          "anyOf": [
            { "$ref": "GenerationProvider.json" },
            { "type": "null" }
          ],
          "description": "Optional generator/orchestrator provenance. Anthropic belongs here when Claude produced the source text before another provider embedded it."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "originalDimensions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "embeddingSpace": {
          "type": "string",
          "minLength": 8,
          "maxLength": 320,
          "description": "Provider, model, source dimension, and normalization identity. Only vectors in the same embedding space may be compared."
        },
        "storageDimensions": {
          "type": "number",
          "const": 4100
        },
        "values": {
          "type": "array",
          "minItems": 4100,
          "maxItems": 4100,
          "items": {
            "type": "number"
          },
          "description": "Finite float values. Slots after originalDimensions MUST be trailing zeros."
        },
        "normalization": {
          "$ref": "EmbeddingNormalization.json"
        },
        "searchText": {
          "anyOf": [
            { "type": "string" },
            { "type": "null" }
          ],
          "maxLength": 200000
        },
        "contentHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "metadata": {
          "$ref": "EmbeddingMetadata.json"
        }
      }
    }
  }
}
