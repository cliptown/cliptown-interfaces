{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cliptown.app/schemas/cloudflare-device-proof-v1.schema.json",
  "title": "ClipTown Cloudflare signed device proof v1",
  "description": "Closed header proof signed by an enrolled Ed25519 device; account, tenant and application identities come exclusively from protected Shared Auth introspection, not this header.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "purpose",
    "device_id",
    "envelope_id",
    "ciphertext_digest",
    "media_kind",
    "device_sequence",
    "key_epoch",
    "revocation_epoch",
    "issued_at_ms",
    "expires_at_ms",
    "nonce",
    "signature"
  ],
  "properties": {
    "protocol": {
      "const": "cliptown.device_auth.v1"
    },
    "purpose": {
      "enum": [
        "text_cache.write",
        "text_cache.read"
      ]
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9:_-]{1,128}$"
    },
    "envelope_id": {
      "type": "string",
      "maxLength": 128
    },
    "ciphertext_digest": {
      "type": "string",
      "pattern": "^([a-f0-9]{64})?$"
    },
    "media_kind": {
      "enum": [
        "text",
        "none"
      ]
    },
    "device_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "key_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740990
    },
    "revocation_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "issued_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at_ms": {
      "type": "integer",
      "minimum": 1
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,86}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "text_cache.write"
          }
        },
        "required": [
          "purpose"
        ]
      },
      "then": {
        "properties": {
          "envelope_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "ciphertext_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "media_kind": {
            "const": "text"
          },
          "device_sequence": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "text_cache.read"
          }
        },
        "required": [
          "purpose"
        ]
      },
      "then": {
        "properties": {
          "envelope_id": {
            "const": ""
          },
          "ciphertext_digest": {
            "const": ""
          },
          "media_kind": {
            "const": "none"
          },
          "device_sequence": {
            "const": 0
          }
        }
      }
    }
  ]
}
