{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cliptown.app/schemas/encrypted-object.schema.json",
  "title": "ClipTown encrypted object manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_id", "object_id", "clip_id", "content_cipher_version", "plaintext_length", "ciphertext_length", "chunk_size", "chunks", "wrapped_keys", "encrypted_metadata", "ciphertext_sha256", "created_at"],
  "properties": {
    "manifest_id": {"type": "string", "format": "uuid"},
    "object_id": {"type": "string", "format": "uuid"},
    "clip_id": {"type": "string", "format": "uuid"},
    "content_cipher_version": {"type": "string", "enum": ["xchacha20poly1305-chunked-v1", "aes-256-gcm-chunked-v1"]},
    "plaintext_length": {"type": "integer", "minimum": 0},
    "ciphertext_length": {"type": "integer", "minimum": 1},
    "chunk_size": {"type": "integer", "minimum": 65536, "maximum": 16777216},
    "chunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunk_index", "ciphertext_length", "ciphertext_sha256", "nonce", "randomized_storage_key"],
        "properties": {
          "chunk_index": {"type": "integer", "minimum": 0},
          "ciphertext_length": {"type": "integer", "minimum": 1},
          "ciphertext_sha256": {"type": "string", "contentEncoding": "base64"},
          "nonce": {"type": "string", "contentEncoding": "base64"},
          "randomized_storage_key": {"type": "string", "minLength": 16, "maxLength": 512}
        }
      }
    },
    "wrapped_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recipient_device_id", "key_id", "algorithm", "nonce", "wrapped_key", "associated_data_hash"],
        "properties": {
          "recipient_device_id": {"type": "string", "format": "uuid"},
          "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "algorithm": {"type": "string", "enum": ["signal-envelope-v1", "xchacha20poly1305-wrap-v1", "aes-256-gcm-wrap-v1"]},
          "nonce": {"type": "string", "contentEncoding": "base64"},
          "wrapped_key": {"type": "string", "contentEncoding": "base64"},
          "associated_data_hash": {"type": "string", "contentEncoding": "base64"}
        }
      }
    },
    "encrypted_metadata": {"type": "object"},
    "ciphertext_sha256": {"type": "string", "contentEncoding": "base64"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
