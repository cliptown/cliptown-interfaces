{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cliptown.dev/schemas/atto-local-source-v1.schema.json",
  "title": "Local AttoLang source metadata (never a server wire type)",
  "description": "A closed-world, pre-encryption-only classification for .atto source. Never upload this record as unencrypted ClipTown metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "language",
    "extension",
    "encoding",
    "byteLength"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scope": {
      "const": "local-pre-encryption"
    },
    "language": {
      "const": "atto"
    },
    "extension": {
      "const": ".atto"
    },
    "encoding": {
      "const": "utf-8"
    },
    "byteLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    }
  }
}
